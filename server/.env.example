# ─────────────────────────────────────────
# TORFA Server - Environment Variables
# ─────────────────────────────────────────
# 1. Copy this file and rename it to .env
# 2. Fill in your actual values below
# 3. NEVER commit the .env file to GitHub!
# ─────────────────────────────────────────

# MongoDB Connection String
# Local:  mongodb://127.0.0.1:27017/torfa
# Cloud:  mongodb+srv://<user>:<password>@cluster.mongodb.net/torfa
MONGO_URI=mongodb://127.0.0.1:27017/torfa

# JWT Secret Key (use any long random string)
JWT_SECRET=replace_with_a_long_random_secret_key_here

# Google Gemini AI API Key
# Get it free from: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Server Port
PORT=5000
